---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";
import { DOC_GROUPS, docPath, type DocNavItem } from "../consts";

type Props = { entry: CollectionEntry<"docs"> };

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const all = await getCollection("docs");
const ordered: DocNavItem[] = all
  .slice()
  .sort(
    (a, b) =>
      DOC_GROUPS.indexOf(a.data.group) - DOC_GROUPS.indexOf(b.data.group) ||
      a.data.order - b.data.order,
  )
  .map((d) => ({
    slug: d.id,
    title: d.data.title,
    group: d.data.group,
    path: docPath(d.id),
  }));

const position = ordered.findIndex((i) => i.slug === entry.id);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  group={entry.data.group}
  source={entry.data.source}
  current={docPath(entry.id)}
  headings={headings}
  items={ordered}
  prev={position > 0 ? ordered[position - 1] : undefined}
  next={position >= 0 && position < ordered.length - 1 ? ordered[position + 1] : undefined}
>
  <Content />
</DocsLayout>
